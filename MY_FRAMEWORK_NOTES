## STEP 5 — CONFIGURATION FILES

### `tsconfig.json`
Key settings explained:
- `"strict": true` — catches null/undefined errors at compile time
- `"resolveJsonModule": true` — allows importing JSON files directly
- `"moduleResolution": "bundler"` — modern resolution, works with Playwright
- No `baseUrl` needed — paths use `./` prefix instead

```json
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@pages/*":    ["./pages/*"],
      "@fixtures/*": ["./fixtures/*"],
      "@utils/*":    ["./utils/*"],
      "@testdata/*": ["./testdata/*"],
      "@config/*":   ["./config/*"]
    }
  },
  "include": [
    "pages/**/*.ts",
    "fixtures/**/*.ts",
    "tests/**/*.ts",
    "utils/**/*.ts",
    "config/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
```

### `playwright.config.ts`
Key concepts:
- `dotenv.config()` loads `config/.env` into `process.env`
- `envKey` = pointer to which environment to use (QAENV or STAG)
- `baseURL` = actual URL resolved from the pointer
- Validation throws clear error if URL is not configured
- `retries: 2` on CI only — local retries hide flakiness
- `workers: 1` on CI — avoids resource contention
- Dual reporters — allure-playwright + html

```typescript
import { defineConfig, devices } from '@playwright/test';
import * as dotenv from 'dotenv';
import * as path from 'path';

dotenv.config({ path: path.resolve(__dirname, 'config/.env') });

const envKey: string = process.env['ENV'] ?? 'QAENV';
const baseURL: string | undefined = process.env[envKey];

if (!baseURL) {
  throw new Error(`[Config Error] ENV="${envKey}" not defined. Check config/.env`);
}

console.log(`▶  Environment : ${envKey}`);
console.log(`▶  Base URL    : ${baseURL}`);

export default defineConfig({
  testDir: './tests',
  fullyParallel: true,
  forbidOnly: !!process.env['CI'],
  retries: process.env['CI'] ? 2 : 0,
  workers: process.env['CI'] ? 1 : undefined,
  reporter: [
    ['allure-playwright', { outputFolder: 'allure-results' }],
    ['html', { outputFolder: 'playwright-report', open: 'never' }],
    ['list'],
  ],
  use: {
    baseURL,
    trace:         'on-first-retry',
    screenshot:    'only-on-failure',
    video:         'retain-on-failure',
    actionTimeout: 15_000,
    launchOptions: {
      args: [
        '--disable-blink-features=AutomationControlled',
        '--no-sandbox',
        '--disable-setuid-sandbox',
      ]
    },
    userAgent: 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
  },
  timeout: 60_000,
  expect: { timeout: 10_000 },
  projects: [
    { name: 'chromium', use: { ...devices['Desktop Chrome'] } },
    { name: 'firefox',  use: { ...devices['Desktop Firefox'] } },
    { name: 'webkit',   use: { ...devices['Desktop Safari'] } },
  ],
});
```

