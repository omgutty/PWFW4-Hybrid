## STEP 8 — UTILITIES

### `utils/Helper.ts`
```typescript
import * as fs   from 'fs';
import * as path from 'path';

// Unique email for each test run — avoids duplicate email errors
export function randomEmail(prefix: string = 'testuser'): string {
  return `${prefix}_${Date.now()}@email.com`;
}

// Random number between min and max inclusive
export function randomNumber(min: number, max: number): number {
  return Math.floor(Math.random() * (max - min + 1)) + min;
}

// Read and parse any JSON file with type safety
export function readJSON<T>(filePath: string): T {
  const absolutePath = path.resolve(process.cwd(), filePath);
  const raw = fs.readFileSync(absolutePath, 'utf-8');
  return JSON.parse(raw) as T;
}

// Append timestamp to any string — creates unique entity names in tests
export function withTimestamp(base: string): string {
  return `${base}_${Date.now()}`;
}
```

