## STEP 9 — PAGE OBJECT LAYER

### Architecture rule
- `BasePage` = parent class, inherited by ALL page classes
- Every page class extends BasePage
- Locators are `private` — only the page's own methods use them
- Tests never access locators directly — they call methods
- `BasePage` contains only methods reusable across ALL pages

### `pages/BasePage.ts`
```typescript
import { Page, Locator, expect } from '@playwright/test';

export class BasePage {
  protected readonly page: Page;

  constructor(page: Page) {
    this.page = page;
  }

  // Navigation
  async goto(path: string): Promise<void> {
    await this.page.goto(path);
  }

  async goBack(): Promise<void>    { await this.page.goBack(); }
  async goForward(): Promise<void> { await this.page.goForward(); }
  getCurrentURL(): string          { return this.page.url(); }

  // Assertions
  async assertUrlContains(pattern: string | RegExp): Promise<void> {
    await expect(this.page).toHaveURL(pattern);
  }

  async assertURLNotContains(pattern: string | RegExp): Promise<void> {
    await expect(this.page).not.toHaveURL(pattern);
  }

  async assertVisible(locator: Locator): Promise<void> {
    await expect(locator).toBeVisible();
  }

  async assertNotVisible(locator: Locator): Promise<void> {
    await expect(locator).not.toBeVisible();
  }

  async assertText(locator: Locator, text: string): Promise<void> {
    await expect(locator).toHaveText(text);
  }

  // Waiting
  async waitForVisible(locator: Locator, timeout = 10_000): Promise<void> {
    await locator.waitFor({ state: 'visible', timeout });
  }

  async wait(ms: number = 2_000): Promise<void> {
    await this.page.waitForTimeout(ms);
  }

  // Dialog handling
  // IMPORTANT: call this BEFORE the action that triggers the dialog
  registerDialogAccept(responseText: string = ''): void {
    this.page.once('dialog', async (dialog) => {
      await dialog.accept(responseText);
    });
  }

  registerDialogDismiss(): void {
    this.page.once('dialog', async (dialog) => {
      await dialog.dismiss();
    });
  }

  // Tab management
  async switchToMainPage(): Promise<void> {
    const pages = this.page.context().pages();
    await this.page.close();
    await pages[0].bringToFront();
  }

  // Logout — available from any authenticated page
  async logout(): Promise<void> {
    await this.page.getByAltText('menu').click();
    await this.page.getByText('Sign out', { exact: true }).click();
  }
}
```

### `pages/LoginPage.ts`
```typescript
import { Page } from '@playwright/test';
import { BasePage } from './BasePage';

export class LoginPage extends BasePage {
  private readonly emailField    = this.page.locator('#email1');
  private readonly passwordField = this.page.locator('#password1');
  private readonly loginButton   = this.page.locator('.submit-btn');

  constructor(page: Page) {
    super(page);
    // Do NOT add this.page = page — BasePage already sets it
  }

  async enterEmail(email: string): Promise<void> {
    await this.emailField.fill(email);    // fill() not type() — type() is deprecated
  }

  async enterPassword(password: string): Promise<void> {
    await this.passwordField.fill(password);
  }

  async clickLoginButton(): Promise<void> {
    await this.loginButton.click();
  }

  // Composite action — use when login is a prerequisite not the subject
  async loginToApplication(email: string, password: string): Promise<void> {
    await this.emailField.fill(email);
    await this.passwordField.evaluate(
      (el) => (el as HTMLInputElement).type = 'password'
    );
    await this.passwordField.fill(password);
    await this.loginButton.click();
    await this.page.waitForLoadState('networkidle');
  }
}
```

### `pages/DashboardPage.ts`
```typescript
import { Page } from '@playwright/test';
import { BasePage } from './BasePage';
import { CategoryPage } from './CategoryPage';

export class DashboardPage extends BasePage {
  private readonly manageMenu           = this.page.getByText('Manage', { exact: true });
  private readonly manageCoursesLink    = this.page.getByText('Manage Courses', { exact: true });
  private readonly manageCategoriesLink = this.page.getByText('Manage Categories', { exact: true });

  constructor(page: Page) { super(page); }

  async navigateToManageCourses(): Promise<void> {
    await this.manageMenu.hover();
    await this.manageCoursesLink.click();
  }

  // Returns CategoryPage because this opens a NEW browser tab (popup)
  // CategoryPage wraps the new tab, not the main page
  async navigateToManageCategories(): Promise<CategoryPage> {
    await this.manageMenu.hover();
    const [newTab] = await Promise.all([
      this.page.waitForEvent('popup'),
      this.manageCategoriesLink.click(),
    ]);
    await newTab.waitForLoadState('networkidle');
    return new CategoryPage(newTab);
  }
}
```

### `pages/CategoryPage.ts`
```typescript
import { Page } from '@playwright/test';
import { BasePage } from './BasePage';

export class CategoryPage extends BasePage {
  private readonly addNewCategoryBtn = this.page.getByText('Add New Category ');

  constructor(page: Page) { super(page); }

  async addCategory(name: string): Promise<void> {
    this.registerDialogAccept(name);    // Register BEFORE clicking — dialog listener must be ready
    await this.addNewCategoryBtn.click();
  }

  async deleteCategory(name: string): Promise<void> {
    await this.page.locator(`//td[text()='${name}']//following::button[1]`).click();
    await this.page.locator("//button[text()='Delete']").click();
  }

  async verifyCategoryVisible(name: string): Promise<void> {
    await this.assertVisible(this.page.getByText(name, { exact: true }));
  }

  async verifyCategoryNotVisible(name: string): Promise<void> {
    await this.assertNotVisible(this.page.getByText(name, { exact: true }));
  }
}
