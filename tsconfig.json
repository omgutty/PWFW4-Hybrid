{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    
    "paths": {
     "@pages/*":    ["./pages/*"],
    "@fixtures/*": ["./fixtures/*"],
    "@utils/*":    ["./utils/*"],
    "@testdata/*": ["./testdata/*"],
     "@config/*":   ["./config/*"]
}
  },
  "include": [
    "pages/**/*.ts",
    "fixtures/**/*.ts",
    "tests/**/*.ts",
    "utils/**/*.ts",
    "config/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
