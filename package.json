{
  "name": "playwright-ts-framework",
  "version": "1.0.0",
  "description": "Enterprise Playwright TypeScript automation framework",
  "type": "commonjs",
  "scripts": {
    "test":               "npx playwright test --headed --project=chromium",
    "smoke":              "npx playwright test tests/LoginTest.spec.ts tests/RegistrationTest.spec.ts",
    "smoke:chrome":       "npx playwright test tests/LoginTest.spec.ts tests/RegistrationTest.spec.ts --project=chromium",
    "smoke:headed":       "npx playwright test tests/LoginTest.spec.ts tests/RegistrationTest.spec.ts --headed --project=chromium",
    "smoke:stag":         "cross-env ENV=STAG npm run smoke:chrome",
    "regression":         "npx playwright test tests/CategoryTest.spec.ts tests/CourseTest.spec.ts --project=chromium",
    "regression:headed":  "npx playwright test tests/CategoryTest.spec.ts tests/CourseTest.spec.ts --headed --project=chromium",
    "regression:stag":    "cross-env ENV=STAG npm run regression",
    "report:clean":       "rimraf allure-results",
    "report:generate":    "allure generate allure-results --clean -o reports",
    "report:open":        "allure open reports"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "allure-playwright": "latest",
    "allure-commandline": "latest",
    "cross-env": "latest",
    "rimraf": "latest"
  },
  "dependencies": {
    "dotenv": "latest"
  }
}